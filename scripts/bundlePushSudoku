# TODO: make these inputs configurable or take these from some central place
if [ "$1" = "p" ]
then 
	environmentType="appcenter_Production"
elif [ "$1" = "s" ]
then
	environmentType="appcenter_Staging"
else
	echo "Error: unknown deployment environment" >&2
	exit 1
fi
appVersionName=$2
revopush release-react Sudoku_Aacharya_android android -d $environmentType -t $appVersionName
